# =======================================================
# Green Campus Awareness Bot - Environment Configuration
# =======================================================

# OpenAI API Key (Obtain from: https://platform.openai.com/api-keys)
# If omitted, EcoBot runs in demonstration mode using its smart campus environmental knowledge engine.
OPENAI_API_KEY=your_openai_api_key_here

# Configurable OpenAI Model (e.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Flask Server Settings
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=green_campus_bot_secure_session_key_2026
